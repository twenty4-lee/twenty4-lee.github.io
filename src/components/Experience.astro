---
import { siteConfig } from "../config";
---

{siteConfig.experience.length > 0 && (
  <section id="experience" class="content-section">
    <h2 class="section-heading">Experience</h2>
    <ol class="entry-list">
      {siteConfig.experience.map((experience) => (
        <li class="experience-entry">
          <p class="entry-date">{experience.dateRange}</p>
          <div class="entry-content">
            <h3 class="entry-title">{experience.title}</h3>
            <p class="entry-meta">{experience.company}</p>
            <ul class="detail-list">
              {experience.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </section>
)}
