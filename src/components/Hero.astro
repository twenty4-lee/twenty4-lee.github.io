---
import { siteConfig } from "../config";
---

<section id="top" class="profile-intro" aria-label="Profile">
  <div class="profile-avatar" aria-hidden="true">YL</div>
  <div class="profile-details">
    <h1 class="profile-name">{siteConfig.name}</h1>
    <p class="profile-role">{siteConfig.title}</p>
    <ul class="profile-links" aria-label="Contact and profiles">
      {siteConfig.social.email && (
        <li><a href={`mailto:${siteConfig.social.email}`}>Email</a></li>
      )}
      {siteConfig.social.linkedin && (
        <li>
          <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </li>
      )}
      {siteConfig.social.github && (
        <li>
          <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        </li>
      )}
    </ul>
  </div>
</section>
