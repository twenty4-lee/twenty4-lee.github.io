---
import { siteConfig } from "../config";
import DateRange from "./DateRange.astro";
---

{siteConfig.education.length > 0 && (
  <section id="education" class="content-section">
    <h2 class="section-heading">Education</h2>
    <ol class="entry-list">
      {siteConfig.education.map((education) => (
        <li class="education-entry">
          <DateRange range={education.dateRange} />
          <div class={`brand-mark brand-mark--${education.brand}`} aria-hidden="true">
            <img src={education.logo} alt="" loading="lazy" />
          </div>
          <div class="entry-content">
            <h3 class="entry-title">{education.degree}</h3>
            <p class="entry-meta">{education.school}</p>
            <p class="department-label">
              <span class={`department-mark department-mark--${education.departmentBrand}`} aria-hidden="true">
                {education.departmentMark}
              </span>
              <span>{education.department}</span>
            </p>
            <ul class="detail-list">
              {education.achievements.map((achievement) => <li>{achievement}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </section>
)}
