---
import { siteConfig } from "../config";
---

{siteConfig.education.length > 0 && (
  <section id="education" class="content-section">
    <h2 class="section-heading">Education</h2>
    <ol class="entry-list">
      {siteConfig.education.map((education) => (
        <li class="education-entry">
          <p class="entry-date">{education.dateRange}</p>
          <div class="entry-content">
            <h3 class="entry-title">{education.degree}</h3>
            <p class="entry-meta">{education.school}</p>
            <ul class="detail-list">
              {education.achievements.map((achievement) => <li>{achievement}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </section>
)}
